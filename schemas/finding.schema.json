{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/whatsmyerror/finding.schema.json",
  "title": "WhatsMyError finding or normalized error event",
  "type": "object",
  "required": ["error_id", "category", "outcome", "severity", "audiences", "messages", "safe_to_retry", "idempotency_required", "confidence", "evidence", "status"],
  "properties": {
    "error_id": {"type": "string", "pattern": "^WME-[A-Z0-9_-]+$"},
    "finding_id": {"type": "string"},
    "category": {"enum": ["NETWORK", "HTTP_CLIENT", "HTTP_SERVER", "AUTH", "VALIDATION", "RATE_LIMIT", "TIMEOUT", "DATABASE", "FILESYSTEM", "DEPENDENCY", "QUEUE", "RESOURCE", "CONFIG", "BUSINESS", "SECURITY", "UNKNOWN"]},
    "outcome": {"enum": ["SUCCESS", "EXPECTED_FAILURE", "TRANSIENT_FAILURE", "PERMANENT_FAILURE", "UNKNOWN"]},
    "severity": {"enum": ["INFO", "WARNING", "ERROR", "CRITICAL"]},
    "http_status": {"type": ["integer", "null"], "minimum": 100, "maximum": 599},
    "protocol": {"type": ["string", "null"]},
    "provider_code": {"type": ["string", "null"]},
    "original_exception_type": {"type": ["string", "null"]},
    "audiences": {"type": "array", "uniqueItems": true, "items": {"enum": ["USER", "SUPPORT", "TECHNICIAN", "SUPERVISOR", "ADMIN"]}},
    "owner_team": {"type": ["string", "null"]},
    "escalation_policy": {"type": ["string", "null"]},
    "messages": {"type": "object", "properties": {"USER": {"type": "string"}, "SUPPORT": {"type": "string"}, "TECHNICIAN": {"type": "string"}, "SUPERVISOR": {"type": "string"}, "ADMIN": {"type": "string"}}, "additionalProperties": false},
    "safe_to_retry": {"type": "boolean"},
    "idempotency_required": {"type": "boolean"},
    "retry_policy": {"type": ["object", "null"]},
    "retry_after_seconds": {"type": ["integer", "null"], "minimum": 0},
    "correlation_id": {"type": ["string", "null"]},
    "trace_id": {"type": ["string", "null"]},
    "timestamp": {"type": ["string", "null"], "format": "date-time"},
    "operation": {"type": ["string", "null"]},
    "dependency": {"type": ["string", "null"]},
    "source_location": {"type": ["object", "null"], "properties": {"path": {"type": "string"}, "line": {"type": "integer", "minimum": 1}}, "required": ["path", "line"], "additionalProperties": false},
    "remediation": {"type": ["string", "null"]},
    "runbook": {"type": ["string", "null"]},
    "confidence": {"enum": ["low", "medium", "high"]},
    "evidence": {"type": "object"},
    "status": {"enum": ["detected", "proposed", "fixed", "verified", "needs_review"]}
  },
  "additionalProperties": true
}
